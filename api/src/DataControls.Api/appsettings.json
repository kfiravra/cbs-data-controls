{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Engine": {
    "BaseUrl": "http://localhost:8000",
    "AttemptTimeout": "00:01:15",
    "BreakerMinimumThroughput": 5,
    "BreakerBreakDuration": "00:00:15"
  },
  "Runs": {
    "RowCap": 5000,
    "TimeZone": "Asia/Jerusalem",
    "DefaultLanguage": "he"
  },
  "Glossary": {
    "CacheMinutes": 10,
    "WarmUpOnStart": true
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
