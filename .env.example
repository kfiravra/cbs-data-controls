# Local configuration for Data Controls. Copy this file to .env (git-ignored) and adjust it:
#   cp .env.example .env
# docker compose, scripts/db-init.sh and scripts/db-check.sh read .env; a variable already set in the
# environment wins over the file. A new git worktree has no .env until you copy one into it.
#
# This file holds no password: set the three below in your .env. Each must pass the SQL Server policy (8 or
# more characters mixing upper case, lower case and digits) and contain no spaces, quotes, $, ; or backslash,
# because it travels as a sqlcmd variable; the scripts refuse a value that does.

# --- database: the SQL Server container and the two application logins ---
MSSQL_SA_PASSWORD=
DQ_APP_PASSWORD=
DQ_ENGINE_RO_PASSWORD=
# Host port that compose publishes SQL Server on (127.0.0.1 only).
DB_PORT=1433

# --- engine: the Python control engine ---
# The SQL Server the engine reads, always as the login dq_engine_ro (its password is in the database block).
# The host goes into the ODBC "Server=" as written: 127.0.0.1 for the compose database (compose publishes it on
# 127.0.0.1 only, and where localhost resolves to ::1 first the driver never falls back), db inside compose, or
# a named instance such as .\SQLEXPRESS (write a value with a backslash without quotes).
ENGINE_DB_HOST=127.0.0.1
# Empty: no port in "Server=" (1433 over TCP, or a named instance's own protocol). A number: host,port.
ENGINE_DB_PORT=1433
ENGINE_DB_NAME=DataControls
# Empty: ODBC Driver 18 for SQL Server when it is installed, else 17. Set: that driver name, as written.
ENGINE_DB_DRIVER=
# The port the start command gives to uvicorn (--port); the engine itself does not read it.
ENGINE_PORT=8000
# Default and maximum of a run's row cap; the total count stays exact above it.
ENGINE_ROW_CAP=5000
# Seconds per statement (a run sends two), and seconds to wait for the database at startup before giving up.
ENGINE_QUERY_TIMEOUT_SECONDS=30
ENGINE_STARTUP_DB_WAIT_SECONDS=30
# "Today" for a run that names no date.
ENGINE_TIME_ZONE=Asia/Jerusalem
# POST /debug/compile shows the SQL of a definition. Keep it false outside development.
ENGINE_DEBUG_COMPILE=false
# Where glossary.json and the definition schema are read from. Empty: contracts/ beside engine/.
ENGINE_CONTRACTS_DIR=
ENGINE_LOG_LEVEL=INFO
# Default number of suggestions (a request may ask for up to 20).
ENGINE_SUGGEST_MAX=10

# --- api: the .NET application API ---
# The api builds its connection string from DQ_APP_PASSWORD and DB_PORT above and from DB_HOST. Every line below
# is a default, commented out; outside Development the api reads only real environment variables, not this file.
# DB_HOST=localhost
# Replaces the built connection string whole, for a server that has no port (a named instance):
# ConnectionStrings__Dq=Server=.\SQLEXPRESS;Database=DataControls;User ID=dq_app;Password=...;TrustServerCertificate=True
# Where the engine listens. Port 8000 may be held by another container on a developer machine.
# Engine__BaseUrl=http://localhost:8000
# The longest one engine call may take; it stays above the engine's worst case for a run (two statements, 30 s each).
# Engine__AttemptTimeout=00:01:15
# The circuit breaker opens after this many calls with half of them failed, and stays open this long.
# Engine__BreakerMinimumThroughput=5
# Engine__BreakerBreakDuration=00:00:15
# The most violations a run stores, and the zone that decides "today" for a run without a date.
# Runs__RowCap=5000
# Runs__TimeZone=Asia/Jerusalem
# Stands in for the glossary's default language until the glossary has been read from the engine.
# Runs__DefaultLanguage=he
# Glossary__CacheMinutes=10
# Glossary__WarmUpOnStart=true
# Origins allowed to call the api from a browser. None by default: ng serve proxies /api.
# Cors__AllowedOrigins__0=http://localhost:4200
