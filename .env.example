# Local configuration for Data Controls. Copy this file to .env (git-ignored) and adjust it:
#   cp .env.example .env
# docker compose, scripts/db-init.sh and scripts/db-check.sh read .env; a variable already set in the
# environment wins over the file. A new git worktree has no .env until you copy one into it.
#
# Passwords must pass the SQL Server policy (8 or more characters mixing upper case, lower case and digits) and
# contain no quotes, $, ; or spaces, because they travel as sqlcmd variables. The values below are for a local
# development container bound to 127.0.0.1; change them for anything shared.

# --- database: the SQL Server container and the two application logins ---
MSSQL_SA_PASSWORD=Dc-Sa-Local-2026
DQ_APP_PASSWORD=Dc-App-Local-2026
DQ_ENGINE_RO_PASSWORD=Dc-Engine-Local-2026
# Host port that compose publishes SQL Server on (127.0.0.1 only).
DB_PORT=1433

# --- engine: the Python control engine (filled by the dc-engine task) ---

# --- api: the .NET application API (filled by the dc-api task) ---
